# Copy these into Vercel Project Settings → Environment Variables (do not commit real values).
# Google Gemini API key used only by the server-side AI endpoint.
GEMINI_API_KEY=
# Firebase project ID and Realtime Database URL.
FIREBASE_PROJECT_ID=shakil-dev-pro
FIREBASE_DATABASE_URL=https://shakil-dev-pro-default-rtdb.asia-southeast1.firebasedatabase.app
# Firebase Admin service-account JSON as a SINGLE-LINE JSON value. Keep private; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
